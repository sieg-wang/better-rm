{
  "better-rm-protection": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/hooks/protect-important-paths.js\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
