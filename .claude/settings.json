{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/hooks/protect-important-paths.js\"",
            "timeout": 5,
            "statusMessage": "Checking protected directories...",
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
