# 以參數展開拆出路徑的最後一段與其 parent，結果放進 PATH_SPLIT_BASENAME 與
# PATH_SPLIT_DIRNAME。
# 為什麼不用 $(basename …)／$(dirname …)：命令替換會吃掉輸出結尾的所有換行，於是
# 以換行結尾的檔名拆完就少了那個換行——釘住 parent 後的 ./basename 指向另一個物件、
# inode 對不上，刪除以「在固定 parent 前已變更」中止，那個檔案於是刪不掉；還原端則
# 會把檔案還原成另一個名字。名字中間的換行沒事，結尾的才會被吃掉。
# 結果透過全域變數回傳也是同一個理由：$(path_split …) 會再吃一次。
# Split a path into its final component and its parent with parameter expansion,
# returning through PATH_SPLIT_BASENAME and PATH_SPLIT_DIRNAME.
# $(basename …) and $(dirname …) are unusable here: command substitution strips
# every trailing newline, so a name ending in one comes back short. The pinned
# ./basename then denotes a different object, the inode comparison fails and the
# delete aborts with "changed before its parent was pinned" -- leaving the file
# undeletable -- while restore would put the file back under a different name. A
# newline in the middle of a name is unaffected; only trailing ones are eaten.
# The globals exist for the same reason: $(path_split …) would strip them again.
path_split() {
    local path="$1"

    # basename "dir/" 是 dir，不是空字串：先剝掉結尾斜線再切。
    # basename "dir/" is dir, not the empty string; strip trailing slashes first.
    while [ "$path" != "/" ] && [ "${path%/}" != "$path" ]; do
        path="${path%/}"
    done

    if [ "$path" = "/" ]; then
        PATH_SPLIT_BASENAME="/"
        PATH_SPLIT_DIRNAME="/"
    elif [[ "$path" == */* ]]; then
        PATH_SPLIT_BASENAME="${path##*/}"
        PATH_SPLIT_DIRNAME="${path%/*}"
        [ -n "$PATH_SPLIT_DIRNAME" ] || PATH_SPLIT_DIRNAME="/"
    else
        PATH_SPLIT_BASENAME="$path"
        PATH_SPLIT_DIRNAME="."
    fi
}

# path_split 的反向操作：把 parent 與最後一段接回絕對路徑，結果放進 PATH_JOIN_RESULT。
# parent 已經以斜線結尾（"/" 就是唯一會發生的情況）時不能再補一條：abs_path 會變成
# //name，而那個字串會原封不動寫進刪除日誌與垃圾桶鏡像路徑，記下來的寫法就跟使用者
# 指名的不是同一個。
# 回傳走全域變數的理由與 path_split 相同：$(path_join …) 會再吃掉結尾換行。
# The inverse of path_split: join a parent and a final component back into an
# absolute path. A parent that already ends in a slash -- "/" being the only case
# that actually occurs -- must not get a second one, or abs_path becomes //name and
# that string lands verbatim in the deletion log and the trash mirror path, spelled
# differently from what the user named.
# Returning through a global is for the same reason as path_split's:
# $(path_join …) would eat the trailing newlines again.
path_join() {
    PATH_JOIN_RESULT="${1%/}/$2"
}

# 移動檔案至垃圾桶
# Move file to trash
move_to_trash() (
    local source="$1"
    local source_label="$1"
    local verbose="$2"
    # 可選的第三個參數：呼叫端已經證明過的 device:inode。給了就代表「只准移動這一個
    # 物件」，來源在這之間被掉包或消失一律中止。--restore 讓位時用得到：它先驗證過
    # 目的地，之後這裡的每一次比對都綁在同一個 inode 上。
    # Optional third argument: a device:inode the caller has already proven. When
    # given it means "move only this exact object"; a swapped or vanished source
    # aborts instead. --restore uses it when clearing a destination out of the
    # way: it proves the destination first, and every check here is then bound to
    # that same inode.
    local expected_identity="${3:-}"
    local invocation_cwd="$PWD"
    local trash_root="$TRASH_DIR"
    if [[ "$trash_root" != /* ]]; then
        trash_root="$invocation_cwd/$trash_root"
    fi
    if [ -n "${BETTER_RM_STATE_DIR:-}" ] &&
       [[ "$BETTER_RM_STATE_DIR" != /* ]]; then
        BETTER_RM_STATE_DIR="$invocation_cwd/$BETTER_RM_STATE_DIR"
    fi

    # 無論路徑是否存在或是否使用強制模式，都先檢查受保護路徑
    # Always check protected paths first, even when the path is missing or force mode is enabled
    if is_protected "$source"; then
        error_msg "拒絕刪除受保護的目錄: '$source'"
        error_msg "Refused to remove protected directory: '$source'"
        error_msg "這是一個重要的系統目錄或專案目錄！"
        error_msg "This is a critical system or project directory!"
        return 1
    fi

    # 檢查檔案或目錄是否存在
    # Check if file or directory exists
    if [ ! -e "$source" ] && [ ! -L "$source" ]; then
        # 呼叫端指名了要移動哪一個 inode，就不能套用 force_mode 的「不存在視同成功」：
        # 那會讓呼叫端以為指定物件已進垃圾桶，實際上什麼都沒發生。
        # When the caller named the exact inode to move, force_mode's "missing is
        # success" shortcut must not apply: it would tell the caller the named
        # object is in the trash when nothing happened at all.
        if [ -n "$expected_identity" ]; then
            error_msg "'$source_label' 在移入垃圾桶前已消失；未移動"
            error_msg "'$source_label' disappeared before it could be trashed; not moved"
            return 1
        fi
        if [ "$force_mode" != "1" ]; then
            error_msg "無法移除 '$source': 沒有此一檔案或目錄"
            error_msg "cannot remove '$source': No such file or directory"
            return 1
        fi
        return 0  # 在強制模式下，忽略不存在的檔案
    fi

    # 在任何昂貴的 hash 或垃圾桶準備前記住來源 inode，接著把此函式的
    # subshell cwd 固定在來源 parent。即使 parent 路徑之後被改名並以
    # symlink 取代，所有後續 ./basename 操作仍解析到原始 parent。
    # Capture the source inode before expensive work, then pin this function's
    # subshell cwd to the source parent. Replacing that parent path later cannot
    # redirect subsequent ./basename operations to an attacker-controlled tree.
    local source_identity
    local source_basename
    local source_parent
    local pinned_identity
    source_identity=$(stat -c '%d:%i' "$source" 2>/dev/null ||
        stat -f '%d:%i' "$source" 2>/dev/null || true)
    if [ -z "$source_identity" ]; then
        error_msg "無法確認 '$source_label' 的 inode 身分；未移動"
        error_msg "Could not verify source inode identity for '$source_label'; not moved"
        return 1
    fi
    if [ -n "$expected_identity" ] && [ "$source_identity" != "$expected_identity" ]; then
        error_msg "'$source_label' 已不是呼叫端驗證過的那個物件；未移動"
        error_msg "'$source_label' is no longer the object the caller verified; not moved"
        return 1
    fi
    path_split "$source"
    source_basename="$PATH_SPLIT_BASENAME"
    source_parent="$PATH_SPLIT_DIRNAME"
    if ! cd "$source_parent" 2>/dev/null; then
        error_msg "無法固定來源 parent '$source_parent'；未移動"
        error_msg "Could not pin source parent '$source_parent'; not moved"
        return 1
    fi
    source="./$source_basename"
    pinned_identity=$(stat -c '%d:%i' "$source" 2>/dev/null ||
        stat -f '%d:%i' "$source" 2>/dev/null || true)
    if [ "$pinned_identity" != "$source_identity" ]; then
        error_msg "來源 '$source_label' 在固定 parent 前已變更；未移動"
        error_msg "Source '$source_label' changed before its parent was pinned; not moved"
        return 1
    fi

    local source_had_same_name_child=0
    local file_type="unknown"
    if [ -d "$source" ] && [ ! -L "$source" ]; then
        file_type="directory"
        if [ -e "$source/$source_basename" ] || [ -L "$source/$source_basename" ]; then
            source_had_same_name_child=1
        fi
    elif [ -L "$source" ]; then
        file_type="symlink"
    elif [ -f "$source" ]; then
        file_type="file"
    fi
    
    # 取得絕對路徑
    # Get absolute path
    local abs_path
    if [ -e "$source" ] || [ -L "$source" ]; then
        # 垃圾桶記錄必須保存 link 本身的名稱，不能解析成 target；否則
        # `--restore <link-name>` 找不到紀錄，並可能以 target 名稱還原。
        # 非 symlink 的來源同樣走這條：parent 已經固定成本函式的 cwd、最後一段就是
        # source_basename，實體絕對路徑組出來與 readlink -f 相同，但不經過命令替換。
        # $(readlink -f …) 會吃掉檔名結尾的所有換行，垃圾桶項目與日誌於是記成另一個
        # 名字，--restore 再也還原不回原本那個。
        # Preserve the link entry's own name in the trash log. Resolving the
        # final symlink here makes `--restore <link-name>` lose that identity.
        # A non-symlink source composes the same way: the parent is already pinned
        # as this function's cwd and the final component is source_basename, so this
        # equals what readlink -f would return without going through command
        # substitution -- which eats a filename's trailing newlines, records the
        # trash entry and the log under a different name, and leaves --restore
        # unable to put the original name back.
        path_join "$(pwd -P)" "$source_basename"
        abs_path="$PATH_JOIN_RESULT"
    else
        if [[ "$source" = /* ]]; then
            abs_path="$source"
        else
            abs_path="$(pwd)/$source"
        fi
    fi
    
    # 建立垃圾桶目錄結構
    # Create trash directory structure
    local trash_path="$trash_root$(dirname "$abs_path")"
    mkdir -p "$trash_path" 2>/dev/null || {
        error_msg "無法建立垃圾桶目錄: $trash_path"
        error_msg "Failed to create trash directory: $trash_path"
        return 1
    }
    
    # 計算檔案內容的 hash 值
    # Calculate hash of file content
    local file_hash=""
    if [ -f "$source" ] && [ ! -L "$source" ]; then
        # 如果是普通檔案（非符號連結），計算 hash
        # If it's a regular file (not a symlink), calculate hash
        # 從 stdin 讀取，輸出才不會帶檔名：檔名含換行時 cut 會逐行處理，
        # 把檔名片段接進 hash，進而污染垃圾桶路徑與日誌。
        # Hash from stdin so the output carries no filename: a filename with a
        # newline makes cut emit a second line, appending part of the name to
        # the hash and corrupting both the trash path and the log record.
        file_hash=$(md5sum 2>/dev/null < "$source" | cut -d' ' -f1)
        if [ -z "$file_hash" ]; then
            # 如果 md5sum 失敗，使用 sha256sum
            # If md5sum fails, use sha256sum
            file_hash=$(sha256sum 2>/dev/null < "$source" | cut -d' ' -f1)
        fi
    elif [ -d "$source" ] && [ ! -L "$source" ]; then
        # 如果是目錄，計算目錄內容的 hash
        # If it's a directory, calculate hash of directory contents
        # 使用 -print0 和 sort -z 以安全處理特殊字元檔名
        # Use -print0 and sort -z to safely handle filenames with special characters
        # 使用 -r 選項以正確處理空目錄
        # Use -r option to correctly handle empty directories
        file_hash=$(find "$source" -type f -print0 2>/dev/null | sort -z | xargs -0 -r md5sum 2>/dev/null | md5sum | cut -d' ' -f1)
        if [ -z "$file_hash" ]; then
            file_hash=$(find "$source" -type f -print0 2>/dev/null | sort -z | xargs -0 -r sha256sum 2>/dev/null | sha256sum | cut -d' ' -f1)
        fi
    fi
    
    # 如果無法計算 hash，使用預設值
    # If hash calculation fails, use default value
    if [ -z "$file_hash" ]; then
        file_hash="nohash"
    fi
    
    # 生成刪除時間戳記（包含奈秒以避免碰撞）
    # Generate deletion timestamp (with nanoseconds to avoid collisions)
    local timestamp
    timestamp=$(date +%Y%m%d_%H%M%S_%N)
    
    # 目標路徑，加上時間戳記和 hash
    # Target path with timestamp and hash
    local target="$trash_root$abs_path"
    target="${target}__${timestamp}__${file_hash}"
    local base_target="$target"
    local reservation=""
    local attempt=0
    local moved=0
    local current_source_identity
    # 時間戳記/hash 組合不保證唯一；保留同層 lock 目錄，並以不覆寫模式移動。
    # The timestamp/hash pair is not unique; reserve a sibling lock directory
    # and move without clobbering. A late writer leaves the source in place.
    # BSD 的 -h 防止將目標 symlink 視為目錄；GNU 的 -T 禁止目錄目標語意。
    # BSD -h does not follow a destination symlink; GNU -T disables directory-target semantics.
    move_without_clobber() {
        case "$(uname -s)" in
            Darwin|FreeBSD|NetBSD|OpenBSD|DragonFly)
                mv -n -h "$@"
                ;;
            *)
                mv -n -T -- "$@"
                ;;
        esac
    }

    while [ "$attempt" -lt 1000 ]; do
        if [ "$attempt" -eq 0 ]; then
            target="$base_target"
        else
            target="${base_target}__${attempt}_$$"
        fi
        reservation="${target}.reserve"
        if mkdir "$reservation" 2>/dev/null; then
            if [ -e "$target" ] || [ -L "$target" ]; then
                rmdir "$reservation" 2>/dev/null || true
                reservation=""
                attempt=$((attempt + 1))
                continue
            fi
            current_source_identity=$(stat -c '%d:%i' "$source" 2>/dev/null ||
                stat -f '%d:%i' "$source" 2>/dev/null || true)
            if [ "$current_source_identity" != "$source_identity" ]; then
                rmdir "$reservation" 2>/dev/null || true
                error_msg "來源 '$source_label' 在移動前已變更；未移動"
                error_msg "Source '$source_label' changed before move; not moved"
                return 1
            fi
            if move_without_clobber "$source" "$target" 2>/dev/null; then
                if [ -e "$source" ] || [ -L "$source" ]; then
                    rmdir "$reservation" 2>/dev/null || true
                    reservation=""
                    attempt=$((attempt + 1))
                    continue
                fi
                # BSD mv 仍可能把實際目錄視為容器；若晚到的 writer 建立 target，
                # 真實目的地會是 target/basename(source)，須回復來源後改用 suffix。
                # BSD mv can still treat a real directory as a container. If a
                # late writer created target, roll target/basename(source) back
                # and retry a suffixed candidate. Never log the container path.
                # 目錄以 inode 身分辨識直接 rename 與來源原有的同名子項目。
                # For directories, inode identity distinguishes a direct rename
                # from a same-named child that was already in the source tree.
                local nested_target="$target/$source_basename"
                local target_identity=""
                local nested_identity=""
                local used_container=0
                if [ -d "$target" ] && [ ! -L "$target" ] &&
                   { [ -e "$nested_target" ] || [ -L "$nested_target" ]; }; then
                    target_identity=$(stat -c '%d:%i' "$target" 2>/dev/null ||
                        stat -f '%d:%i' "$target" 2>/dev/null || true)
                    nested_identity=$(stat -c '%d:%i' "$nested_target" 2>/dev/null ||
                        stat -f '%d:%i' "$nested_target" 2>/dev/null || true)
                    if [ "$file_type" != "directory" ]; then
                        used_container=1
                    elif [ -n "$source_identity" ] &&
                         [ "$nested_identity" = "$source_identity" ]; then
                        used_container=1
                    elif [ "$target_identity" != "$source_identity" ] &&
                         [ "$source_had_same_name_child" -eq 0 ]; then
                        used_container=1
                    fi
                fi
                if [ "$used_container" -eq 1 ]; then
                    if move_without_clobber "$nested_target" "$source" 2>/dev/null; then
                        local rollback_identity=""
                        local rollback_recovery_path="$source/$source_basename"
                        local rollback_recovery_identity=""
                        rollback_identity=$(stat -c '%d:%i' "$source" 2>/dev/null ||
                            stat -f '%d:%i' "$source" 2>/dev/null || true)
                        if [ -n "$source_identity" ] &&
                           [ "$rollback_identity" = "$source_identity" ] &&
                           { [ ! -e "$nested_target" ] && [ ! -L "$nested_target" ]; }; then
                            rmdir "$reservation" 2>/dev/null || true
                            reservation=""
                            attempt=$((attempt + 1))
                            continue
                        fi
                        rollback_recovery_identity=$(
                            stat -c '%d:%i' "$rollback_recovery_path" 2>/dev/null ||
                            stat -f '%d:%i' "$rollback_recovery_path" 2>/dev/null ||
                            true
                        )
                        if [ -n "$source_identity" ] &&
                           [ "$rollback_recovery_identity" = "$source_identity" ]; then
                            rmdir "$reservation" 2>/dev/null || true
                            error_msg "rollback 後來源身分不符；原始項目保留於 '$rollback_recovery_path'"
                            error_msg "Rollback identity mismatch; original item preserved at '$rollback_recovery_path'"
                            return 1
                        fi
                    fi
                    # 並發 writer 也可能佔用原始路徑、使 rollback 失敗；此時只記錄
                    # 實際可還原路徑，絕不可把攻擊者目錄當作垃圾桶項目。
                    # A concurrent writer may occupy the source path and block
                    # rollback. Record only the actual recoverable path, never
                    # the attacker-controlled directory container.
                    if [ -e "$nested_target" ] || [ -L "$nested_target" ]; then
                        local remaining_nested_identity=""
                        remaining_nested_identity=$(stat -c '%d:%i' "$nested_target" 2>/dev/null ||
                            stat -f '%d:%i' "$nested_target" 2>/dev/null || true)
                        if [ -n "$source_identity" ] &&
                           [ "$remaining_nested_identity" = "$source_identity" ]; then
                            target="$nested_target"
                            moved=1
                            break
                        fi
                    fi
                    rmdir "$reservation" 2>/dev/null || true
                    error_msg "無法確認 '$source' 的垃圾桶位置"
                    error_msg "Could not verify the trash destination for '$source'"
                    return 1
                fi
                moved=1
                break
            fi
            if { [ -e "$target" ] || [ -L "$target" ]; } &&
               { [ -e "$source" ] || [ -L "$source" ]; }; then
                rmdir "$reservation" 2>/dev/null || true
                reservation=""
                attempt=$((attempt + 1))
                continue
            fi
            rmdir "$reservation" 2>/dev/null || true
            error_msg "無法移除 '$source'"
            error_msg "Failed to remove '$source'"
            return 1
        fi
        reservation=""
        attempt=$((attempt + 1))
    done
    if [ "$moved" -ne 1 ]; then
        error_msg "無法保留唯一的垃圾桶路徑: $base_target"
        error_msg "Failed to reserve a unique trash path: $base_target"
        return 1
    fi

    rmdir "$reservation" 2>/dev/null || true
    # 記錄刪除操作到日誌。寫不進去時的實情是「東西已經在垃圾桶裡，但 --restore 找不到
    # 它」；這句話只有呼叫端有辦法講清楚，所以用獨立的結束碼 3 傳出去，而不是混進 0
    # （謊稱一切正常）或 1（謊稱東西沒被移走）。
    # Log the deletion. When that write fails, the truth is "the item IS in the
    # trash but --restore cannot find it" — wording that only the caller can
    # supply, so it leaves as its own exit code 3 instead of being folded into 0
    # (claiming all is well) or 1 (claiming nothing was moved).
    local logged=0
    log_deletion "$abs_path" "$target" "$file_hash" "$timestamp" "$file_type" || logged=$?

    if [ "$verbose" = "1" ]; then
        success_msg "已移除 '$source_label' (moved to trash: $target)"
    fi
    if [ "$logged" -ne 0 ]; then
        return 3
    fi
    return 0
)

# 移除字串前後空白
# Trim leading and trailing whitespace
trim() {
    local var="$*"
    # remove leading whitespace characters
    var="${var#"${var%%[![:space:]]*}"}"
    # remove trailing whitespace characters
    var="${var%"${var##*[![:space:]]}"}"
    echo -n "$var"
}

# 取得路徑的「裝置:inode」身分。symlink 取連結本身而非其目標，因此被掉包的連結
# 不可能冒充成同一個物件。路徑不存在或無法 stat 時輸出空字串，呼叫端必須把空字串
# 當成「無法確認」而非「相符」。
# Report a path's device:inode identity. Symlinks are identified by the link
# itself, not by its target, so a swapped link cannot pass as the same object.
# An unreadable or missing path yields the empty string; callers must treat that
# as "cannot confirm", never as a match.
path_identity() {
    stat -c '%d:%i' "$1" 2>/dev/null ||
        stat -f '%d:%i' "$1" 2>/dev/null ||
        true
}

# 以 rename 語意搬移。$1 是覆蓋政策：-f 代表「取代既有目的地」（呼叫端已取得使用者
# 同意），-n 代表「絕不覆蓋」。目的地是「指向目錄的 symlink」時絕不搬進去，而是取代
# 該連結：GNU 用 -T，連「真目錄」也一併涵蓋；BSD 只有 -h，真目錄仍會被當成容器。
# 而且 BSD 的 -n 在目的地已存在時是「靜默不做事並回傳 0」，所以呼叫端一律必須在事後
# 用 inode 驗證落點，不能倚賴旗標或結束碼。
# Move with rename semantics. $1 is the clobber policy: -f replaces an existing
# target (the caller already has the user's consent), -n never overwrites. When
# the target is a symlink to a directory, replace the link instead of moving into
# it: GNU's -T also covers a real directory target, BSD only has -h and still
# treats a real directory as a container. BSD's -n moreover does nothing and
# returns 0 when the target exists, so every caller must verify the landing spot
# by inode afterwards rather than trusting the flag or the exit status.
move_exact() {
    case "$(uname -s)" in
        Darwin|FreeBSD|NetBSD|OpenBSD|DragonFly)
            mv "$1" -h -- "$2" "$3"
            ;;
        *)
            mv "$1" -T -- "$2" "$3"
            ;;
    esac
}

# 解析出垃圾桶根目錄的絕對路徑（TRASH_DIR 允許是相對路徑）
# Absolute path of the trash root (TRASH_DIR may be relative).
absolute_trash_root() {
    if [[ "$TRASH_DIR" = /* ]]; then
        printf '%s' "$TRASH_DIR"
    else
        printf '%s/%s' "$PWD" "$TRASH_DIR"
    fi
}

# 往上找到最近一個確實存在的祖先路徑。垃圾桶目錄常常還沒建立，但它所在的檔案系統
# 已經可以由某個祖先問出來。都問不到時輸出空字串。
# The nearest ancestor that actually exists. The trash directory is often still
# to be created, yet the filesystem it will live on can already be probed through
# an ancestor. Outputs the empty string when nothing can be probed.
nearest_existing_path() {
    local probe="$1"
    while [ -n "$probe" ] && [ ! -e "$probe" ]; do
        local parent="${probe%/*}"
        if [ "$parent" = "$probe" ]; then
            break
        fi
        probe="${parent:-/}"
    done
    if [ -e "$probe" ]; then
        printf '%s' "$probe"
    fi
}

# 回報路徑所在檔案系統的可用空間（KB）。無法判斷時輸出空字串，呼叫端必須把空字串
# 當成「不知道」，不可當成 0。
# Free space in KB on the filesystem holding a path. An empty result means
# "unknown" and callers must treat it as such, never as zero.
filesystem_free_kb() {
    df -Pk "$1" 2>/dev/null | awk 'NR==2 {print $4; exit}'
}

# 要量「垃圾桶裝不裝得下」，就得量東西真正會落下去的那個目錄所在的檔案系統，而不是
# 垃圾桶根目錄——根目錄底下可能掛著別的卷宗。落點目錄通常還不存在，所以往上找最近的
# 既有祖先，但絕不允許走到垃圾桶根目錄外面（那已經是另一顆磁碟了，量了也沒有意義）。
# Measuring "does the trash have room" means measuring the filesystem holding the
# directory the object will actually land in, not the trash root — another volume
# can be mounted below it. That directory usually does not exist yet, so the
# nearest existing ancestor is used, but never one above the trash root: that is
# already a different disk and measuring it would answer the wrong question.
trash_landing_probe() {
    local root="$1"
    local landing="$2"
    local probe
    probe=$(nearest_existing_path "$root$landing")
    case "$probe" in
        "$root"|"$root"/*)
            printf '%s' "$probe"
            return 0
            ;;
    esac
    nearest_existing_path "$root"
}

# 回報路徑實際佔用的空間（KB）。無法判斷時輸出空字串。
# Disk usage of a path in KB; empty when it cannot be determined.
path_size_kb() {
    du -sk "$1" 2>/dev/null | awk 'NR==1 {print $1; exit}'
}

# 還原檔案
# Restore file
restore_file() {
    local target_name="$1"
    local force="$2"
    local verbose="$3"
    
    local primary_log
    local legacy_log="$TRASH_DIR/.deletion_log"
    local log_file
    local log_files=()
    primary_log=$(get_deletion_log_file)

    if [ -f "$primary_log" ]; then
        log_files+=("$primary_log")
    fi
    if [ -f "$legacy_log" ]; then
        log_files+=("$legacy_log")
    fi

    if [ ${#log_files[@]} -eq 0 ]; then
        error_msg "找不到刪除日誌，無法還原檔案"
        error_msg "Deletion log not found, cannot restore file"
        return 1
    fi
    
    # 從日誌尾部開始尋找符合檔名/路徑的刪除記錄
    # Search from the end of the log for a matching deletion record
    local trash_path=""
    local original_path=""
    local file_hash=""
    local timestamp=""
    local file_type=""
    
    # 依序讀取新日誌與舊版垃圾桶日誌
    # Read the new log first, then the legacy trash log
    local IFS=$'\n'
    local lines=()
    local found=0
    local i

    # 便宜的預先排除：先用字串比對刷掉絕大多數紀錄，就不必為它們付出切欄位、
    # trim 與解碼的成本 —— 日誌只增不減，掃描成本會隨時間單調變差。
    # 成立範圍要講清楚：本工具寫出的 v2 欄位一定是 encode_log_field 的輸出（每個
    # 反斜線都已加倍），在那個像上「原始路徑含目標名稱 ⇒ 整行含其轉義形式」可證；
    # 但對任意手工編造的 v2 欄位並不成立，例如 `/craft/\a\\b.txt`（未知轉義 \a 緊
    # 鄰標準的 \\）解碼後是 `/craft/\a\b.txt`，字面與標準轉義兩種寫法都不會出現在
    # 原始行裡而被跳過。那種紀錄 better-rm 自己不會寫出，且結果是「找不到」
    # （fail-closed），不會還原到錯的檔案。
    # Cheap pre-rejection: a raw-string test drops the vast majority of records
    # before paying for field splitting, trims and decoding — the log is
    # append-only, so that cost grows monotonically over the tool's lifetime.
    # Scope of the argument: fields this tool writes are always the image of
    # encode_log_field (every backslash already doubled), and on that image
    # "the original path contains the target name" does imply "the raw line
    # contains its escaped spelling". It does NOT hold for an arbitrary
    # hand-written v2 field: `/craft/\a\\b.txt` (an unknown escape \a next to a
    # canonical \\) decodes to `/craft/\a\b.txt`, yet neither the literal nor
    # the canonical spelling occurs in the raw line, so the record is skipped.
    # better-rm never writes such a record, and the outcome is NOT FOUND
    # (fail-closed) rather than restoring the wrong file.
    local needle="${target_name#./}"
    local needle_encoded
    needle_encoded=$(encode_log_field "$needle")
    for log_file in "${log_files[@]}"; do
        lines=()
        if ! {
            while read -r line || [[ -n "$line" ]]; do
                if [[ -n "$line" && ! "$line" =~ ^# ]]; then
                    lines+=("$line")
                fi
            done < "$log_file"
        } 2>/dev/null; then
            continue
        fi

        for ((i=${#lines[@]}-1; i>=0; i--)); do
            local line="${lines[i]}"
            # 先做便宜排除（見上方說明）：兩種寫法都不含目標名稱就不可能匹配。
            # Cheap rejection first: a line holding neither spelling of the
            # target name cannot match, so it never needs parsing.
            if [[ "$line" != *"$needle"* && "$line" != *"$needle_encoded"* ]]; then
                continue
            fi
            # 解析日誌行：
            # v2  → TIMESTAMP | v2 | ORIGINAL_PATH | TRASH_PATH | HASH | FILE_TYPE（路徑已轉義）
            # 舊版 → TIMESTAMP | ORIGINAL_PATH | TRASH_PATH | HASH | FILE_TYPE
            # 舊紀錄是升級前寫下的，必須照樣讀得懂，否則已在垃圾桶的項目會還原不了。
            # 判別依據：單行的舊紀錄第 2 欄一定是絕對路徑，不可能等於 "v2"。
            # 但檔名含換行的舊紀錄本來就會被拆成多個實體行，其中一行仍可能剛好
            # 有 6 欄且第 2 欄是 "v2"；那種紀錄在此修正前後同樣無法正確解析
            # （這正是 v2 要解決的問題），不是新的破口。
            # Legacy records predate the v2 marker and must keep working, or
            # items already in the trash become unrestorable after an upgrade.
            # The discriminator holds for SINGLE-LINE legacy records: their
            # second field is an absolute path and can never be "v2". A legacy
            # record whose filename contains a newline was already split across
            # physical lines, and such a fragment can carry six fields with "v2"
            # in the second one; those records were unparseable before this
            # change too — that is the very defect v2 exists to fix.
            local parts=()
            IFS='|' read -r -a parts <<< "$line"

            # 版本標記用參數展開判斷，不呼叫 trim：那是命令替換，等於每掃一行就
            # fork 一次子行程，長日誌會被這個成本主導。
            # Test the version marker with parameter expansion rather than trim:
            # trim runs in a command substitution, i.e. one fork per scanned
            # line, which dominates the cost on a long log.
            local marker="${parts[1]-}"
            marker="${marker# }"
            marker="${marker% }"
            if [ ${#parts[@]} -ge 6 ] && [ "$marker" = "v2" ]; then
                # 只剝掉分隔符兩側各一個空白，保留檔名本身的前後空白
                # Strip only the single delimiter space on each side so spaces
                # that belong to the filename survive.
                local encoded_original="${parts[2]}"
                local encoded_trash="${parts[3]}"
                encoded_original="${encoded_original# }"
                encoded_original="${encoded_original% }"
                encoded_trash="${encoded_trash# }"
                encoded_trash="${encoded_trash% }"
                decode_log_field "$encoded_original"
                original_path="$LOG_FIELD_DECODED"
                decode_log_field "$encoded_trash"
                trash_path="$LOG_FIELD_DECODED"
                timestamp=$(trim "${parts[0]}")
                file_hash=$(trim "${parts[4]}")
                file_type=$(trim "${parts[5]}")
            else
                timestamp=$(trim "${parts[0]}")
                original_path=$(trim "${parts[1]}")
                trash_path=$(trim "${parts[2]}")
                file_hash=$(trim "${parts[3]}")
                file_type=$(trim "${parts[4]}")
            fi

            # 檢查 trash_path 是否真的存在於磁碟上
            if [ ! -e "$trash_path" ] && [ ! -L "$trash_path" ]; then
                continue
            fi

            # 比對規則：
            # 1. 如果 target_name 是絕對路徑，則精確比對 original_path
            # 2. 如果 target_name 是相對路徑或僅檔名，則檢查 original_path 是否以 "/target_name" 結尾，或是 original_path 是否等於 "/target_name"
            local match=0
            if [[ "$target_name" = /* ]]; then
                if [ "$original_path" = "$target_name" ]; then
                    match=1
                fi
            else
                # 移除 target_name 開頭的 ./（如果有的話）
                local clean_target="${target_name#./}"
                if [ "$original_path" = "/$clean_target" ] || [[ "$original_path" = */"$clean_target" ]]; then
                    match=1
                fi
            fi

            if [ $match -eq 1 ]; then
                found=1
                break 2
            fi
        done
    done
    
    if [ $found -eq 0 ]; then
        error_msg "在垃圾桶中找不到符合 '$target_name' 的刪除記錄或檔案本體"
        error_msg "No matching deletion record or file found in trash for '$target_name'"
        return 1
    fi
    
    # 決定還原目的地：目前資料夾下的相同檔名
    # Restore destination: same filename in the current folder
    # $(basename …) 會吃掉結尾換行，檔案就會被還原成少一個換行的另一個名字。
    # $(basename …) eats trailing newlines and would restore the file under a
    # different name than the one that was deleted.
    local dest_filename
    path_split "$original_path"
    dest_filename="$PATH_SPLIT_BASENAME"
    local dest_path="$(pwd)/$dest_filename"
    
    # 檢查目標路徑是否已存在同名檔案/目錄
    # Check if a file/directory with the same name already exists in the destination
    local dest_existed=0
    if [ -e "$dest_path" ] || [ -L "$dest_path" ]; then
        dest_existed=1
        if [ "$force" != "1" ]; then
            echo -n "rm: 檔案或目錄 '$dest_filename' 已存在於目前資料夾，是否覆蓋？(y/N) " >&2
            read -r response
            if [[ ! "$response" =~ ^[yY] ]]; then
                echo "操作已取消 / Operation cancelled" >&2
                return 0
            fi
        fi
    fi
    
    # 還原的不變式：better-rm 不會遞迴刪除任何讓位物件。舊寫法先把垃圾桶項目 mv 到
    # 目的地，再對讓位路徑 /bin/rm -rf。即使讓位落點
    # 改用 mktemp -d（名稱不可預測、建立為獨佔），同 UID 的並行行程仍可枚舉父目錄找到
    # 它，搶先在 $staging/<name> 建立自己的目錄：讓位那次 mv 於是變成「搬進去」，成功
    # 路徑的 rm -rf 便連同對方的內容一起刪掉，而 --restore 依然回報 exit 0。實測一支
    # 純 glob 輪詢（不 fork）的並行行程，10 次裡贏 9 次、其中 7 次 exit 0。
    # 所以這裡不再倚賴「刪除」來完成覆蓋：先把垃圾桶項目搬進本行程獨佔建立的暫存目錄
    # （跨裝置的複製發生在這一步，目的地全程沒被碰過），再用同一檔案系統內的一次
    # rename 就位。rename(2) 是原子的，而且覆蓋路徑上根本沒有「依路徑刪除」這個
    # 步驟，也就沒有可被搶佔的空窗。
    # 讓位不再挑目的地的形狀：覆蓋等於刪除，所以佔著目的地的任何東西——檔案、目錄、
    # 符號連結、硬連結——都在就位之前先讓位，而讓位一律是「把舊目的地移入垃圾桶」：
    # 可還原、有 log、絕不 rm -rf。因此 rename 通常落在一個空路徑上。
    # （這裡以前只在 rename 換不掉目的地時才讓位——目的地是真目錄，或取出的項目是真
    # 目錄而目的地不是——其餘一律靠 rename 解除舊 inode 的連結，那個檔案就此消失。）
    # The invariant: better-rm never recursively deletes a displaced object. The old shape moved the
    # trashed item onto the destination and then /bin/rm -rf'd the move-aside
    # path. Even with mktemp -d (unpredictable name, atomic exclusive creation) a
    # same-UID concurrent process can enumerate the parent directory, find the
    # staging directory and pre-create its own directory at $staging/<name>: the
    # set-aside mv then moves INTO it and the success path's rm -rf takes the
    # unrelated contents with it, while --restore still reports exit 0. Measured:
    # a fork-free glob-polling process won 9 of 10 runs, 7 of them with exit 0.
    # So the overwrite no longer relies on deletion at all. The trashed item is
    # moved into a staging directory this process created exclusively (the
    # cross-device copy, if any, happens there while the destination is still
    # untouched) and is then put in place by a single same-filesystem rename.
    # rename(2) is atomic and there is no delete-by-path step anywhere on the
    # overwrite path, hence no window to hijack. The set-aside no longer depends on
    # the destination's shape either: an overwrite is a deletion, so whatever
    # occupies the destination — file, directory, symlink, hardlink — is set aside
    # before the publish, and the set-aside is always a move INTO THE TRASH:
    # recoverable, logged, never rm -rf'd. The publish rename therefore normally
    # lands on an empty path.
    # (It used to set aside only when rename could not replace the destination at
    # all — a real directory, or a staged real directory over a non-directory —
    # and let the kernel unlink the old inode in every other case, which is the
    # overwrite that destroyed the occupant.)
    local trash_identity=""
    local staging_dir=""
    local staging_identity=""
    local incoming=""
    local dest_identity=""
    # 取出後，暫存區裡那個物件的身分。同一裝置時它就是垃圾桶項目的 inode；跨裝置時
    # mv 是複製，inode 必然是新的，之後每一步都必須跟「暫存區這一份」比對，而不是跟
    # 已經不存在的原 inode 比對。
    # Identity of the object sitting in staging after extraction. Within one
    # device it is the trashed item's own inode; across devices mv copied it, so
    # the inode is necessarily new and every later step must be checked against
    # the staged copy rather than against an inode that no longer exists.
    local staged_identity=""
    # 暫存目錄一律建立在目的地的 parent 裡，所以 staging <-> 目的地永遠是同裝置的
    # rename；只有 staging <-> 垃圾桶這一段才可能跨裝置。
    # The staging directory always lives in the destination's parent, so
    # staging <-> destination is always a same-device rename. Only the
    # staging <-> trash leg can cross devices.
    local cross_device=0
    local clobber_policy="-n"
    if [ "$dest_existed" = "1" ]; then
        # 使用者已同意覆蓋（-f 或互動確認）才允許取代既有目的地；否則一律不覆蓋，
        # 才不會把「還原期間才被建立的檔案」默默蓋掉。
        # Only replace an existing destination once the user has consented (-f or
        # the interactive prompt); otherwise never clobber, so a file created at
        # that path while the restore is running is not silently overwritten.
        clobber_policy="-f"
    fi

    trash_identity=$(path_identity "$trash_path")
    if [ -z "$trash_identity" ]; then
        error_msg "還原失敗：無法確認垃圾桶項目的 inode 身分"
        error_msg "Restore failed: cannot confirm the inode identity of the trashed item"
        return 1
    fi

    # 還原硬性依賴 mktemp：整個覆蓋流程建立在「一個只有本行程能建立、名稱不可預測的
    # 暫存目錄」上，沒有它就沒有安全的還原路徑，因此 fail closed。缺的是什麼要講出來，
    # 否則使用者只會看到一句無從下手的「無法建立暫存目錄」。
    # Restore hard-depends on mktemp: the whole overwrite path is built on a
    # staging directory only this process can have created under an unpredictable
    # name, and without it there is no safe route, so it fails closed. Say what is
    # missing, or the user is left with an unactionable "cannot create it".
    if ! command -v mktemp >/dev/null 2>&1; then
        error_msg "還原失敗：找不到 mktemp，無法建立獨佔的暫存目錄（還原需要它）"
        error_msg "Restore failed: mktemp was not found and the exclusive staging directory it creates is required by --restore"
        return 1
    fi
    if ! staging_dir=$(mktemp -d "${dest_path}.better-rm-restore-XXXXXX" 2>/dev/null); then
        error_msg "還原失敗：無法在目的地旁建立獨佔的暫存目錄"
        error_msg "Restore failed: cannot create an exclusive staging directory beside the destination"
        return 1
    fi
    staging_identity=$(path_identity "$staging_dir")
    incoming="$staging_dir/$dest_filename"
    staged_identity="$trash_identity"
    if [ "${trash_identity%%:*}" != "${staging_identity%%:*}" ]; then
        cross_device=1
    fi
    if [ -z "$staging_identity" ]; then
        rmdir "$staging_dir" 2>/dev/null
        error_msg "還原失敗：無法確認暫存目錄的 inode 身分"
        error_msg "Restore failed: cannot confirm the staging directory's inode identity"
        return 1
    fi

    # 中止時的復原：把取出的項目放回垃圾桶。任何一步不成立就把「東西實際在哪裡」
    # 講清楚，但絕不刪除任何東西。既有目的地的讓位是「移入垃圾桶」，本身就已經是
    # 可還原狀態，所以不在這裡搬回來——由呼叫端明講一句 `rm --restore` 即可。
    # Unwind on abort: put the extracted item back in the trash. Whatever cannot
    # be put back is named explicitly — but nothing is ever deleted to make it
    # fit. An existing destination is set aside by moving it INTO the trash,
    # which is already a recoverable state, so it is not pulled back here; the
    # caller says so and names the `rm --restore` that recovers it.
    restore_unwind() {
        local sunk="$dest_path/$dest_filename"
        if [ "$(path_identity "$sunk")" = "$staged_identity" ]; then
            move_exact -n "$sunk" "$incoming" 2>/dev/null || true
        fi
        if [ "$(path_identity "$incoming")" = "$staged_identity" ]; then
            # 放回垃圾桶這一段可能跨裝置：那是一次複製，inode 一定不同，因此只能
            # 驗證「垃圾桶原路徑確實又有東西了」。同裝置時仍以 inode 嚴格驗證。
            # Putting it back can cross devices: that is a copy, so the inode is
            # necessarily different and only "something is at the trash path
            # again" can be verified. Within one device keep the strict check.
            local put_back=1
            if ! move_exact -n "$incoming" "$trash_path" 2>/dev/null; then
                put_back=0
            elif [ "$cross_device" = "1" ]; then
                if { [ ! -e "$trash_path" ] && [ ! -L "$trash_path" ]; } ||
                   { [ -e "$incoming" ] || [ -L "$incoming" ]; }; then
                    put_back=0
                fi
            elif [ "$(path_identity "$trash_path")" != "$trash_identity" ]; then
                put_back=0
            fi
            if [ "$put_back" != "1" ]; then
                error_msg "垃圾桶項目暫留於 '$incoming'"
                error_msg "The trashed item is left at '$incoming'"
            fi
        fi
        rmdir "$staging_dir" 2>/dev/null || true
    }

    # 取出垃圾桶項目到暫存目錄。跨裝置時 mv 退化成「複製後刪除」，那段較長、較容易
    # 失敗的過程在這裡完成，此刻目的地仍原封不動。
    #
    # 驗收條件必須依「是否同一個檔案系統」分開寫。同一裝置時 mv 就是 rename，inode
    # 必然保留，所以 inode 相等是可用的證明。跨裝置時 mv 是「複製後刪除」，inode
    # 必然改變 —— 若仍要求 inode 相等，等於讓每一次跨裝置還原都必定失敗（外接碟、
    # 網路磁碟、另一個 APFS volume 搭配預設的 $HOME/.Trash 都會走到這裡）。
    # Split the acceptance test by filesystem. Within one device mv is a rename,
    # so the inode is necessarily preserved and inode equality is a usable proof.
    # Across devices mv is copy-then-unlink, so the inode necessarily CHANGES;
    # demanding equality there makes every cross-device restore fail by
    # construction — an external drive, a network mount or a second APFS volume
    # combined with the default $HOME/.Trash all take this path.
    local trash_basename
    trash_basename=$(basename "$trash_path")
    local buried="$incoming/$trash_basename"
    local extracted=0
    local incoming_identity=""
    if move_exact -n "$trash_path" "$incoming" 2>/dev/null; then
        incoming_identity=$(path_identity "$incoming")
        if [ "$cross_device" = "0" ]; then
            if [ "$incoming_identity" = "$trash_identity" ]; then
                extracted=1
            fi
        elif [ -n "$incoming_identity" ] &&
             { [ ! -e "$trash_path" ] && [ ! -L "$trash_path" ]; } &&
             { [ ! -e "$buried" ] && [ ! -L "$buried" ]; }; then
            # 跨裝置的驗收：來源已被 mv 消耗、暫存落點確實有東西，且該落點不是
            # 「並行行程先建好的目錄、項目被搬進去」的形狀。inode 在這裡不可用，
            # 這三個條件是本平台上 shell 能取得的最強證據。
            # Cross-device acceptance: the source was consumed by mv, something
            # exists at the staging path, and that path is not the "a concurrent
            # process pre-created a directory and the item was moved inside it"
            # shape. Inode identity is unusable here; these three conditions are
            # the strongest evidence available to a shell on this platform.
            extracted=1
        fi
    fi
    if [ "$extracted" = "1" ]; then
        staged_identity="$incoming_identity"
    fi
    if [ "$extracted" != "1" ]; then
        # 暫存目錄雖為獨佔建立，同 UID 的並行行程仍可能枚舉後搶先佔用 $incoming；
        # BSD mv 此時會把項目搬「進」對方的目錄，必須撈回垃圾桶再中止。同一裝置時
        # 以 inode 證明；跨裝置時無法比 inode，但「垃圾桶來源已消失且 $buried 存在」
        # 只可能是這次 mv 造成的：若 $buried 事先就存在，mv -n 會什麼都不做並讓來源
        # 留在原地。
        # The staging directory is created exclusively, but a same-UID process can
        # still enumerate it and occupy $incoming first; BSD mv then moves the
        # item INTO that directory, so pull it back to the trash before aborting.
        # Same device proves it by inode. Across devices inode comparison is
        # impossible, but "the trash source is gone AND $buried exists" can only
        # have been produced by this mv: had $buried pre-existed, mv -n would have
        # done nothing and left the source in place.
        if { [ -e "$buried" ] || [ -L "$buried" ]; } &&
           { [ ! -e "$trash_path" ] && [ ! -L "$trash_path" ]; } &&
           { [ "$(path_identity "$buried")" = "$trash_identity" ] ||
             [ "$cross_device" = "1" ]; }; then
            move_exact -n "$buried" "$trash_path" 2>/dev/null || true
        fi
        # 中止時「什麼東西實際在哪裡」必須講出來。跨裝置的複製可能已經消耗了垃圾桶
        # 來源，此時使用者的資料就只剩暫存目錄裡那一份；沉默地回傳 1 會讓使用者以為
        # 檔案還在垃圾桶，而下一次 --restore 只會說「找不到」。
        # An abort must name what is actually where. A cross-device copy may
        # already have consumed the trash source, leaving the staging copy as the
        # only surviving instance of the user's data; returning 1 silently would
        # let the user believe it is still in the trash while the next --restore
        # only reports "not found".
        if ! rmdir "$staging_dir" 2>/dev/null; then
            if { [ ! -e "$trash_path" ] && [ ! -L "$trash_path" ]; } &&
               { [ -e "$incoming" ] || [ -L "$incoming" ]; }; then
                # 垃圾桶來源已經不在，暫存區這一份就是僅存的一份，必須指名。
                # The trash source is gone, so the staged copy is the only
                # surviving instance and has to be named outright.
                error_msg "'$dest_filename' 的資料目前留在 '$incoming'"
                error_msg "The data for '$dest_filename' is currently left at '$incoming'"
            else
                error_msg "暫存目錄 '$staging_dir' 非空，未刪除；請檢查其內容"
                error_msg "The staging directory '$staging_dir' is not empty and was left in place; inspect it"
            fi
        fi
        error_msg "還原失敗：無法將檔案移回目前資料夾"
        error_msg "Restore failed: cannot move file back to current folder"
        return 1
    fi

    # 同意檢查時目的地不存在，就沒有任何覆蓋授權。取出期間才出現的東西不是合法的
    # 覆蓋對象：把項目放回垃圾桶並原封不動地留下它。
    # 這道閘門與下面 publish 的 `-n` 是重複的保護，但兩者擋的不是同一件事：`-n` 只
    # 保證「不覆蓋」，BSD mv 仍會把項目搬「進」那個目錄再由 unwind 撈出來。撈得回來
    # 是運氣；撈不回來項目就卡在別人的樹裡。這裡的契約更強 —— 未經授權的目的地，
    # 連一次 mv 的落點都不可以是它。
    # No overwrite was authorized when the destination was absent at the consent
    # check, so anything that appeared during the extraction is not a legal
    # overwrite target: put the item back and leave the newcomer untouched.
    # This gate overlaps the `-n` on the publish below, but they do not stop the
    # same thing: `-n` only guarantees "do not clobber", and BSD mv still moves
    # the item INTO such a directory for the unwind to pull back out. Getting it
    # back is luck; failing to leaves the item stranded in someone else's tree.
    # The contract here is stronger — an unauthorized destination must never be
    # the target of even one mv.
    if [ "$dest_existed" = "0" ] &&
       { [ -e "$dest_path" ] || [ -L "$dest_path" ]; }; then
        restore_unwind
        error_msg "還原失敗：目的地 '$dest_filename' 在還原期間出現，未經同意不得覆蓋"
        error_msg "Restore failed: destination '$dest_filename' appeared during restore and overwrite was not authorized"
        return 1
    fi

    # 覆蓋等於刪除，而 better-rm 的全部價值就是刪除必須可還原：佔著目的地的那個物件
    # 一律要先讓位，publish 才可以發生——不管 rename 換不換得掉它。
    # 先前只有 rename(2) 無法原子取代的兩種形狀才讓位：
    #   rename(檔案, 真目錄)  -> EISDIR / ENOTEMPTY
    #   rename(真目錄, 非目錄) -> ENOTDIR      <- 還原一個目錄到既有檔案/symlink 上
    # 其餘情況倚賴 rename 自己把舊 inode 解除連結，於是 `rm -f --restore -- <檔案>`
    # 會 exit 0、不提示、把佔位的檔案或 symlink 就地銷毀，垃圾桶與工作目錄都不留——
    # 那正是這個工具存在要禁止的事。Linux 的 `mv -T` 一樣是 rename(2)，所以這不是
    # macOS 專屬。
    #
    # 讓位的方式是「送進垃圾桶」，不是 rm -rf。走 move_to_trash 還一併拿到它已經硬化
    # 過的邏輯：pin 住 parent、唯一化目標路徑、寫入 deletion log，於是舊目的地用
    # `rm --restore` 就能取回。
    #
    # 順序本身就是保證：讓位在 publish 之前完成，讓不了位就 restore_unwind 並中止，
    # 目的地連碰都沒被碰過。反過來（先 publish、再處理舊目的地）在任何失敗下都等於
    # 已經把它吃掉了。
    # An overwrite is a deletion, and better-rm's entire point is that deletions
    # are recoverable: whatever occupies the destination is always cleared out of
    # the way before the publish, whether or not rename could replace it.
    # Only the two shapes rename(2) cannot replace atomically used to be cleared:
    #   rename(file, real dir)  -> EISDIR / ENOTEMPTY
    #   rename(real dir, non-dir) -> ENOTDIR   <- restoring a directory onto an
    #                                             existing file or symlink
    # Everything else relied on rename unlinking the old inode itself, so
    # `rm -f --restore -- <file>` exited 0 with no prompt and destroyed the
    # occupying file or symlink outright, leaving it in neither the trash nor the
    # working directory — exactly what this tool exists to prevent. Linux's
    # `mv -T` is rename(2) as well, so this is not macOS-specific.
    #
    # It is cleared by going INTO THE TRASH, not by rm -rf. Routing it through
    # move_to_trash also inherits that function's hardening — pinned parent,
    # uniquified target, deletion-log record — so the old destination comes back
    # with `rm --restore`.
    #
    # The ordering is the guarantee: the set-aside completes before the publish,
    # and a set-aside that cannot complete unwinds and aborts with the destination
    # never touched. The reverse order (publish first, deal with the old
    # destination after) means any failure has already eaten it.
    #
    # 讓位有兩條路：
    #   1. 移入垃圾桶（預設）：有 deletion log，可用 rm --restore 取回。
    #   2. 就地讓位：在目的地旁邊獨佔建立一個目錄，用同裝置的 rename 把它搬進去。
    # 跨裝置時第 1 條會退化成一次完整複製，需要垃圾桶那顆磁碟真的裝得下。實測的迴歸：
    # 20MB 的垃圾桶卷宗配 41MB 的舊目的地，第 1 條在 ENOSPC 半途死掉，留下一份 20MB
    # 的半成品複本永久佔著垃圾桶磁碟（而且沒有任何訊息提到它），使用者的檔案停在暫存
    # 目錄裡沒還原，日誌指向的垃圾桶來源也已被消耗。rename 完全不需要額外空間，所以
    # 第 2 條在磁碟全滿時仍然成立——先量再決定要走哪一條。
    # Two routes clear the old destination out of the way:
    #   1. into the trash (default): it gets a deletion-log record and comes back
    #      with rm --restore;
    #   2. aside in place: an exclusively created directory next to the
    #      destination, reached by a same-filesystem rename.
    # Across devices route 1 degrades into a full copy and needs the trash volume
    # to actually have room. Measured regression: a 20MB trash volume and a 41MB
    # destination make route 1 die of ENOSPC half way, leaving a permanent 20MB
    # half-copy nothing mentions, while the user's file is never restored and the
    # trash source the log points at has already been consumed. A rename needs no
    # space at all, so route 2 still works on a full volume — measure first, then
    # pick the route.
    local displaced_trashed=0
    local displaced_unlogged=0
    local displaced_dir=""
    local displaced_local=""

    # 就地讓位：把已驗證身分的舊目的地搬進獨佔建立的同層目錄。成功時 $displaced_local
    # 就是它的新位置；失敗時不留下任何東西（除非落點被別人佔走，那就明講）。
    # Set the destination aside in place: move the object whose identity was
    # already proven into an exclusively created sibling directory. On success
    # $displaced_local names its new location; on failure nothing is left behind
    # unless another process occupied the landing spot, which is then named.
    displace_destination_locally() {
        local dir
        if ! dir=$(mktemp -d "${dest_path}.better-rm-displaced-XXXXXX" 2>/dev/null); then
            return 1
        fi
        local landing="$dir/$dest_filename"
        if ! move_exact -n "$dest_path" "$landing" 2>/dev/null ||
           [ "$(path_identity "$landing")" != "$dest_identity" ]; then
            if ! rmdir "$dir" 2>/dev/null; then
                error_msg "讓位落點 '$dir' 非空，未刪除；請檢查其內容"
                error_msg "The set-aside directory '$dir' is not empty and was left in place; inspect it"
            fi
            return 1
        fi
        displaced_dir="$dir"
        displaced_local="$landing"
        return 0
    }

    if [ "$dest_existed" = "1" ] &&
       { [ -e "$dest_path" ] || [ -L "$dest_path" ]; }; then
        dest_identity=$(path_identity "$dest_path")
        if [ -z "$dest_identity" ]; then
            restore_unwind
            error_msg "還原失敗：無法確認既有 '$dest_filename' 的 inode 身分"
            error_msg "Restore failed: cannot confirm the inode identity of the existing '$dest_filename'"
            return 1
        fi
        # 受保護的路徑不適用就地讓位：那是 move_to_trash 的拒絕理由，不是空間
        # 問題，繞過去等於自己拆掉保護。
        # A protected path never takes the in-place route: move_to_trash
        # refuses it on principle rather than for lack of space, and routing
        # around that refusal would dismantle the protection.
        local displace_in_place=0
        local displaceable=1
        if is_protected "$dest_path" >/dev/null 2>&1; then
            displaceable=0
        fi
        if [ "$displaceable" = "1" ]; then
            local trash_probe=""
            local trash_device=""
            local trash_free_kb=""
            local dest_size_kb=""
            # 落點目錄要用「解析過 symlink 的 parent」算，move_to_trash 自己就是
            # 這樣決定垃圾桶路徑的（abs_path 是「cd 進來源 parent 後的 pwd -P」
            # 接上最後一段）。用未解析的 pwd 會算出一個不存在的落點，於是退回去
            # 量垃圾桶根目錄——在根目錄底下掛了別的卷宗時，那量到的是另一顆磁碟。
            # The landing directory has to be derived from the symlink-resolved
            # parent, because that is how move_to_trash itself builds the trash
            # path (abs_path is the pwd -P of the pinned source parent joined
            # with the final component). An unresolved pwd yields a landing that
            # does not exist, falling back to the trash root — which is the wrong
            # disk whenever another volume is mounted below it.
            local dest_parent_real
            dest_parent_real=$(cd "$(dirname "$dest_path")" 2>/dev/null && pwd -P)
            if [ -z "$dest_parent_real" ]; then
                dest_parent_real=$(dirname "$dest_path")
            fi
            trash_probe=$(trash_landing_probe "$(absolute_trash_root)" "$dest_parent_real")
            if [ -n "$trash_probe" ]; then
                trash_device=$(path_identity "$trash_probe")
                trash_device="${trash_device%%:*}"
            fi
            # 量不出來就照舊走垃圾桶那條路：不知道並不等於裝不下。
            # An unmeasurable filesystem keeps the trash route: "unknown" is
            # not "does not fit".
            if [ -n "$trash_device" ] &&
               [ "$trash_device" != "${dest_identity%%:*}" ]; then
                trash_free_kb=$(filesystem_free_kb "$trash_probe")
                dest_size_kb=$(path_size_kb "$dest_path")
                if [ -n "$trash_free_kb" ] && [ -n "$dest_size_kb" ] &&
                   [ "$dest_size_kb" -ge "$trash_free_kb" ] 2>/dev/null; then
                    displace_in_place=1
                    warn_msg "垃圾桶所在磁碟只剩 ${trash_free_kb}KB，裝不下 ${dest_size_kb}KB 的既有 '$dest_filename'；不移入垃圾桶"
                    warn_msg "The trash volume has ${trash_free_kb}KB free, too little for the existing '$dest_filename' (${dest_size_kb}KB); it is not going into the trash"
                fi
            fi
        fi
        if [ "$displace_in_place" = "0" ]; then
            # 把驗證過的 inode 交給 move_to_trash：從這裡到實際移動之間若被掉包，
            # 它會中止而不是移動別人的東西。
            # Hand the proven inode to move_to_trash: if the path is swapped
            # between here and the actual move it aborts instead of moving an
            # unrelated object.
            move_to_trash "$dest_path" 0 "$dest_identity"
            local displace_status=$?
            if [ "$displace_status" -eq 0 ]; then
                displaced_trashed=1
            elif [ "$displace_status" -eq 3 ]; then
                # 東西進了垃圾桶，但刪除日誌沒寫成功——rm --restore 找不到它，
                # 訊息不能照抄成功版本。
                # It is in the trash but the deletion log was not written, so
                # rm --restore cannot find it and the message must not claim
                # otherwise.
                displaced_trashed=1
                displaced_unlogged=1
            elif [ "$displaceable" = "1" ] &&
                 [ "$(path_identity "$dest_path")" = "$dest_identity" ]; then
                # 沒能移入垃圾桶，但舊目的地確實還是那個已驗證的物件（例如空間在
                # 量完之後才不夠、或垃圾桶暫時寫不進去）：改走就地讓位，使用者同意
                # 的覆蓋仍然完成，而舊目的地一樣不會被銷毀。身分不符就不是它了，
                # 一律中止。
                # The trash route failed but the old destination really is
                # still the object that was verified (space ran out after the
                # measurement, the trash is momentarily unwritable, …): fall
                # back to the in-place route so the consented overwrite still
                # completes and the old destination still is not destroyed. A
                # mismatching identity is a different object; abort instead.
                displace_in_place=1
            else
                restore_unwind
                error_msg "還原失敗：無法把既有的 '$dest_filename' 移入垃圾桶讓位"
                error_msg "Restore failed: cannot move the existing '$dest_filename' into the trash to make room"
                return 1
            fi
        fi
        if [ "$displace_in_place" = "1" ] && ! displace_destination_locally; then
            restore_unwind
            error_msg "還原失敗：無法把既有的 '$dest_filename' 移到旁邊讓位"
            error_msg "Restore failed: cannot set the existing '$dest_filename' aside to make room"
            return 1
        fi
    fi

    # 就位：同一檔案系統內的一次 rename。目的地若是既有檔案或 symlink，核心會原子地
    # 以新項目取代它並解除舊 inode 的連結，全程沒有任何「依路徑刪除」。
    # Put it in place with a single same-filesystem rename. If the destination is
    # an existing file or symlink the kernel replaces it atomically and unlinks
    # the old inode as part of the same call — no delete-by-path anywhere.
    if ! move_exact "$clobber_policy" "$incoming" "$dest_path" 2>/dev/null ||
       [ "$(path_identity "$dest_path")" != "$staged_identity" ]; then
        restore_unwind
        if [ "$displaced_trashed" = "1" ]; then
            # 讓位已經發生：舊的目的地此刻在垃圾桶裡，而且 deletion log 記的是它
            # 原本的路徑。exit 1 的契約要求指名任何回不了原位的東西 —— 這裡就是。
            # The set-aside already happened: the old destination is in the trash
            # and the deletion log holds its original path. The exit-1 contract
            # requires naming anything that could not be put back; this is it.
            if [ "$displaced_unlogged" = "1" ]; then
                error_msg "既有的 '$dest_filename' 已移入垃圾桶且未放回，但刪除日誌沒寫成功，rm --restore 取不回它；請在垃圾桶 '$TRASH_DIR' 底下依原路徑尋找"
                error_msg "The existing '$dest_filename' was moved into the trash and not put back, and the deletion log was not written, so rm --restore cannot find it; look under the trash root '$TRASH_DIR' at its original path"
            else
                error_msg "既有的 '$dest_filename' 已移入垃圾桶且未放回，請用 rm --restore '$dest_filename' 取回"
                error_msg "The existing '$dest_filename' was moved into the trash and not put back; recover it with rm --restore '$dest_filename'"
            fi
        fi
        if [ -n "$displaced_local" ]; then
            # 就地讓位是同裝置的 rename，放回去一樣不需要空間：能放回就放回，狀態
            # 回到呼叫前；放不回去就指名它現在在哪裡。
            # The in-place set-aside is a same-filesystem rename, so putting it
            # back needs no space either: do that and the state is the one the
            # call started from. If it cannot go back, name where it now is.
            if { [ ! -e "$dest_path" ] && [ ! -L "$dest_path" ]; } &&
               move_exact -n "$displaced_local" "$dest_path" 2>/dev/null &&
               [ "$(path_identity "$dest_path")" = "$dest_identity" ]; then
                rmdir "$displaced_dir" 2>/dev/null || true
            else
                error_msg "既有的 '$dest_filename' 仍留在 '$displaced_local'"
                error_msg "The existing '$dest_filename' is still at '$displaced_local'"
            fi
        fi
        error_msg "還原失敗：無法將檔案就位到 '$dest_path'"
        error_msg "Restore failed: cannot put the item in place at '$dest_path'"
        return 1
    fi

    if [ "$displaced_trashed" = "1" ]; then
        # 使用者同意的是「覆蓋」，不是「銷毀」。舊目的地去了哪裡必須主動說，否則
        # 使用者無從得知它還救得回來。日誌沒寫成功時尤其不能照抄成功版本的話術：
        # 那句 `rm --restore` 會直接回「找不到刪除記錄」。
        # The user consented to an overwrite, not to destruction. Where the old
        # destination went has to be stated, or the user has no way to know it is
        # still recoverable. When the log write failed the success wording must
        # not be reused: that `rm --restore` answers "no deletion record found".
        if [ "$displaced_unlogged" = "1" ]; then
            warn_msg "既有的 '$dest_filename' 已移入垃圾桶讓位，但刪除日誌沒寫成功，rm --restore 取不回它；請在垃圾桶 '$TRASH_DIR' 底下依原路徑尋找"
            warn_msg "The existing '$dest_filename' was moved into the trash to make room, but the deletion log was not written, so rm --restore cannot find it; look under the trash root '$TRASH_DIR' at its original path"
        else
            warn_msg "既有的 '$dest_filename' 已移入垃圾桶讓位，可用 rm --restore '$dest_filename' 取回"
            warn_msg "The existing '$dest_filename' was moved into the trash to make room; recover it with rm --restore '$dest_filename'"
        fi
    fi

    local restore_status=0
    if [ -n "$displaced_local" ]; then
        # 就地讓位的東西不在垃圾桶裡，`rm --restore` 對它無效，所以必須指名實際路徑。
        # 這是降級的結果，不是乾淨的完成：讓位的那一個躺在垃圾桶外面、也不在刪除日誌
        # 裡，收拾它是使用者的事。因此結束碼不能與什麼都沒發生的成功相同，用既有的 2
        # （「部分成功、殘留物已指名、絕不回 0」，與暫存目錄沒清掉時同一個意思）；
        # 路徑也同時印在 stdout，把 stderr 丟掉的呼叫端才有辦法知道東西去了哪裡。
        # 那兩行刻意不上色也不走 warn_msg：它是給呼叫端讀的資料，不是裝飾。
        # An in-place set-aside is not in the trash and `rm --restore` does not
        # reach it, so the actual path has to be named. It is a degraded outcome
        # rather than a clean completion: the displaced object sits outside the
        # trash and outside the deletion log, and clearing it up is the user's job.
        # The exit code therefore must not be the one a clean success returns; it is
        # the existing 2 -- "partial success, the residue is named, never 0", the
        # same meaning it already carries for a staging directory that could not be
        # removed. The path also goes to stdout, so a caller that discards stderr
        # can still learn where the object went. Those two lines are deliberately
        # uncoloured and not warn_msg: they are data for a caller, not decoration.
        warn_msg "既有的 '$dest_filename' 已移到 '$displaced_local' 讓位；它不在垃圾桶裡，rm --restore 取不回，請自行搬回或刪除"
        warn_msg "The existing '$dest_filename' was set aside at '$displaced_local'; it is not in the trash, rm --restore cannot reach it, so move it back or remove it yourself"
        echo "rm: 既有的 '$dest_filename' 已移到 '$displaced_local' 讓位（不在垃圾桶裡）"
        echo "rm: the existing '$dest_filename' was set aside at '$displaced_local' (not in the trash)"
        restore_status=2
    fi

    if ! rmdir "$staging_dir" 2>/dev/null; then
        warn_msg "已還原 '$dest_filename'，但暫存目錄 '$staging_dir' 非空，未刪除"
        warn_msg "Restored '$dest_filename', but the staging directory '$staging_dir' is not empty and was left in place"
        return 2
    fi

    if [ "$verbose" = "1" ]; then
        success_msg "已還原 '$dest_filename' 到目前資料夾 (restored to: $dest_path)"
    fi
    return "$restore_status"
}

# 主程式
# Main program
main() {
    # 參數解析變數
    # Parameter parsing variables
    local recursive=0
    local force_mode=0
    local interactive=0
    local interactive_once=0
    local verbose=0
    local restore_mode=0
    local restore_target=""
    local files=()
    
    # 如果沒有參數，顯示錯誤
    # If no arguments, show error
    if [ $# -eq 0 ]; then
        error_msg "缺少操作對象"
        error_msg "missing operand"
        echo "Try 'rm --help' for more information." >&2
        return 1
    fi
    
    # 解析參數
    # Parse arguments
    while [ $# -gt 0 ]; do
        case "$1" in
            --help)
                show_help
                return 0
                ;;
            --version)
                show_version
                return 0
                ;;
            --restore)
                restore_mode=1
                shift
                # -- 之後的那一個引數就是還原目標，即使以破折號開頭。刪除端認得 --
                # 而還原端不認得的話，-- 想解決的那一類檔名就變成單向：刪得掉、還原
                # 不回來。
                # 沒有 -- 時契約不變：緊接著的破折號開頭引數仍算「缺少引數」，否則
                # 誤打的 `--restore -f` 會被默默當成要還原的檔名。
                # After --, the next argument is the restore target even when it
                # starts with a dash. Honouring -- on the delete side only would make
                # exactly the class of names -- exists for one-way: deletable, but not
                # restorable.
                # Without --, the contract is unchanged: a dash-leading argument is
                # still a missing argument, or a mistyped `--restore -f` would be
                # taken silently as the name to restore.
                local restore_terminated=0
                if [ $# -gt 0 ] && [ "$1" = "--" ]; then
                    restore_terminated=1
                    shift
                fi
                if [ $# -gt 0 ] && { [ "$restore_terminated" -eq 1 ] || [[ "$1" != -* ]]; }; then
                    restore_target="$1"
                    shift
                    # -- 之後只收這一個檔名。刪除端的 -- 吃掉所有剩下的引數，還原端
                    # 只吃一個，範圍本來就不同；多出來的那個絕不能默默變成旗標——實測
                    # `--restore -- victim.txt -f` 會以 -f 強制覆蓋，目的地無提示地被
                    # 換掉且完全沒進垃圾桶。默默丟掉也不行：還原路徑上「安靜地不照你
                    # 說的做」是最糟的失敗模式。旗標寫在 --restore 前面依然照舊。
                    # After --, exactly one pathname is taken. The delete side's --
                    # consumes every remaining argument and this side consumes one, so
                    # the scopes genuinely differ, and the extra must never turn into a
                    # flag: measured, `--restore -- victim.txt -f` force-overwrote the
                    # destination with no prompt and left nothing in the trash. Silently
                    # dropping it is no better -- quietly not doing what you were told is
                    # the worst failure mode on a restore path. A flag written before
                    # --restore keeps working exactly as it did.
                    if [ "$restore_terminated" -eq 1 ] && [ $# -gt 0 ]; then
                        error_msg "'--restore --' 之後只接受一個路徑，多出來的引數：'$1'"
                        error_msg "'--restore --' takes exactly one pathname; unexpected extra argument: '$1'"
                        return 1
                    fi
                else
                    error_msg "選項 '--restore' 需要一個引數"
                    error_msg "option '--restore' requires an argument"
                    return 1
                fi
                ;;
            -r|-R|--recursive)
                recursive=1
                shift
                ;;
            -f|--force)
                force_mode=1
                interactive=0  # -f 覆蓋 -i
                shift
                ;;
            -i)
                interactive=1
                force_mode=0  # -i 覆蓋 -f
                shift
                ;;
            -I)
                interactive_once=1
                shift
                ;;
            -v|--verbose)
                verbose=1
                shift
                ;;
            -rf|-fr|-Rf|-fR|-RF|-Fr|-rF|-RF)
                # 組合參數處理 - 只處理常見的 rf 組合
                # Handle combined parameters - only common rf combinations
                recursive=1
                force_mode=1
                interactive=0
                shift
                ;;
            --)
                # 選項終止符：其後全部是路徑，即使以破折號開頭。必須排在 -*) 之前，
                # 否則裸 -- 會被當成組合參數並以「無效的選項 -- '-'」失敗。
                # Option terminator: everything after it is a pathname, dash-leading
                # names included. It has to precede -*) or the bare -- is parsed as a
                # combined option bundle and dies with "invalid option -- '-'".
                shift
                while [ $# -gt 0 ]; do
                    # 破折號開頭的相對路徑要補 ./：後面用來釘住來源 inode 的 stat
                    # 會把 -dash.txt 當成自己的選項，刪除便以「無法確認 inode 身分」
                    # 中止。釘住 parent 之後的每一步本來就是操作 ./basename。
                    # A dash-leading relative path needs the ./ prefix: the stat that
                    # pins the source inode would parse -dash.txt as its own option and
                    # the delete would abort on "could not verify inode identity". Every
                    # step after the parent is pinned already operates on ./basename.
                    case "$1" in
                        -*) files+=("./$1") ;;
                        *) files+=("$1") ;;
                    esac
                    shift
                done
                ;;
            -*)
                # 處理其他組合參數
                # Handle other combined parameters
                local arg="$1"
                shift
                local i
                local has_f=0
                local has_i=0
                local f_pos=-1
                local i_pos=-1
                
                # 第一次掃描：找出 f 和 i 的位置
                for ((i=1; i<${#arg}; i++)); do
                    case "${arg:$i:1}" in
                        f) has_f=1; f_pos=$i ;;
                        i) has_i=1; i_pos=$i ;;
                    esac
                done
                
                # 第二次掃描：處理所有選項
                for ((i=1; i<${#arg}; i++)); do
                    case "${arg:$i:1}" in
                        r|R) recursive=1 ;;
                        f) 
                            # 如果 i 也存在且在 f 之後，則 i 優先
                            if [ $has_i -eq 1 ] && [ $i_pos -gt $f_pos ]; then
                                : # 什麼都不做，讓 i 處理
                            else
                                force_mode=1
                                interactive=0
                            fi
                            ;;
                        i) 
                            # 如果 f 也存在且在 i 之後，則 f 優先
                            if [ $has_f -eq 1 ] && [ $f_pos -gt $i_pos ]; then
                                : # 什麼都不做，讓 f 處理
                            else
                                interactive=1
                                force_mode=0
                            fi
                            ;;
                        I) interactive_once=1 ;;
                        v) verbose=1 ;;
                        *)
                            error_msg "無效的選項 -- '${arg:$i:1}'"
                            error_msg "invalid option -- '${arg:$i:1}'"
                            echo "Try 'rm --help' for more information." >&2
                            return 1
                            ;;
                    esac
                done
                ;;
            *)
                files+=("$1")
                shift
                ;;
        esac
    done
    
    # 如果是還原模式
    # If in restore mode
    if [ "$restore_mode" = "1" ]; then
        restore_file "$restore_target" "$force_mode" "$verbose"
        return $?
    fi

    # 檢查是否有指定檔案
    # Check if files are specified
    if [ ${#files[@]} -eq 0 ]; then
        error_msg "缺少操作對象"
        error_msg "missing operand"
        echo "Try 'rm --help' for more information." >&2
        return 1
    fi
    
    # -I 選項：當刪除超過 3 個檔案時提示一次
    # -I option: prompt once when removing more than 3 files
    if [ "$interactive_once" = "1" ] && [ ${#files[@]} -gt 3 ]; then
        echo -n "rm: remove ${#files[@]} arguments? " >&2
        read -r response
        if [[ ! "$response" =~ ^[yY] ]]; then
            return 0
        fi
    fi
    
    # 確保垃圾桶目錄存在
    # Ensure trash directory exists
    if [ ! -d "$TRASH_DIR" ]; then
        mkdir -p "$TRASH_DIR" || {
            error_msg "無法建立垃圾桶目錄: $TRASH_DIR"
            error_msg "Failed to create trash directory: $TRASH_DIR"
            return 1
        }
    fi
    
    # 處理每個檔案
    # Process each file
    local status=0
    for file in "${files[@]}"; do
        # 檢查是否為目錄
        # Check if it's a directory
        if [ -d "$file" ] && [ ! -L "$file" ]; then
            if [ "$recursive" != "1" ]; then
                error_msg "無法移除 '$file': 是一個目錄"
                error_msg "cannot remove '$file': Is a directory"
                status=1
                continue
            fi
        fi
        
        # 互動式確認
        # Interactive confirmation
        if [ "$interactive" = "1" ]; then
            local prompt
            if [ -d "$file" ] && [ ! -L "$file" ]; then
                prompt="rm: descend into directory '$file'? "
            else
                prompt="rm: remove file '$file'? "
            fi
            echo -n "$prompt" >&2
            read -r response
            if [[ ! "$response" =~ ^[yY] ]]; then
                continue
            fi
        fi
        
        # 移動到垃圾桶。結束碼 3 是「已移入垃圾桶，但刪除日誌沒寫成功」——刪除本身
        # 成功了（警告已經印出來），所以刪除的結束狀態維持 0，一如日誌不可用時的
        # 既有行為。
        # Move to trash. Exit code 3 means "moved into the trash, but the deletion
        # log could not be written": the removal itself succeeded and already
        # warned, so the removal's exit status stays 0, exactly as it did before
        # when the log was unavailable.
        local move_status=0
        move_to_trash "$file" "$verbose" || move_status=$?
        if [ "$move_status" -ne 0 ] && [ "$move_status" -ne 3 ]; then
            status=1
        fi
    done
    
    return $status
}

# 執行主程式
# Execute main program
main "$@"
