#!/bin/bash
#
# better-rm - A safer rm command that moves files to trash instead of permanent deletion
# 更安全的 rm 命令，將檔案移至垃圾桶而非永久刪除
#

# 設定垃圾桶目錄 (可透過環境變數 TRASH_DIR 更改)
# Set trash directory (can be changed via TRASH_DIR environment variable)
TRASH_DIR="${TRASH_DIR:-$HOME/.Trash}"

# 解析 better-rm 狀態目錄
# Resolve the better-rm state directory
resolve_state_dir() {
    if [ -n "${BETTER_RM_STATE_DIR:-}" ]; then
        printf '%s\n' "$BETTER_RM_STATE_DIR"
    elif [[ "${XDG_STATE_HOME:-}" = /* ]]; then
        printf '%s/better-rm\n' "$XDG_STATE_HOME"
    else
        printf '%s/.local/state/better-rm\n' "$HOME"
    fi
}

# 取得刪除日誌路徑
# Get the deletion log path
get_deletion_log_file() {
    local state_dir
    state_dir=$(resolve_state_dir)
    printf '%s/deletion.log\n' "$state_dir"
}

# 受保護的目錄清單 - 禁止刪除這些重要目錄
# Protected directories list - prevent deletion of these critical directories
PROTECTED_DIRS=(
    "/"
    "/Applications"
    "/Library"
    "/Network"
    "/System"
    "/System/Volumes"
    "/Users"
    "/Volumes"
    "/bin"
    "/boot"
    "/cores"
    "/dev"
    "/etc"
    "/home"
    "/lib"
    "/lib64"
    "/mnt"
    "/opt"
    "/private"
    "/proc"
    "/root"
    "/sbin"
    "/sys"
    "/usr"
    "/var"
    "$HOME"
    "$HOME/"
)

# 受保護的目錄模式清單 (使用萬用字元)
# Protected directory patterns (using wildcards)
# .git 內部的路徑與 .git 本身一樣不可還原：`rm -rf .git/objects` 毀掉的是整個倉庫。
# 前四項只認「路徑結束在 .git」，所以 .git 底下的一切原本都是普通的刪除目標；
# `*/.git/*` 把 .git 當成路徑元件來認，與 agent 路徑上那道 hook 一致（它從一開始就
# 拒絕任何含有 .git 元件的路徑），兩道守衛不再對同一條路徑給出相反的答案。
# 這條規則會擋掉一件正當的事：git 中斷後手動清 .git/index.lock。這是刻意選的方向
# ——擋過頭只是不方便，擋不夠丟的是資料——真的要清的人用 /bin/rm（不經過本工具，
# 也就沒有垃圾桶）。是否要為 lockfile 開豁免是維護者的政策裁決，這裡不自行決定。
# A path inside .git is as unrecoverable as .git itself: `rm -rf .git/objects` loses
# the repository. The four entries above match only a path that ENDS at .git, so
# everything below it was an ordinary deletion target. `*/.git/*` matches .git as a
# path COMPONENT, the way the agent-path hook has always done, so the two guards no
# longer answer the same path differently.
# This refuses one legitimate thing: clearing a stale .git/index.lock by hand after
# an interrupted git operation. The direction is deliberate -- too strict costs an
# inconvenience, too loose costs data -- and /bin/rm still does it (outside this
# tool, so with no trash copy). Whether to carve out an exemption for lockfiles is a
# policy call for the maintainer, not one made here.
PROTECTED_PATTERNS=(
    ".git"
    ".git/"
    "*/.git"
    "*/.git/"
    "*/.git/*"
)

# 顏色定義 (Color definitions)
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# 顯示錯誤訊息
# Display error message
error_msg() {
    echo -e "${RED}錯誤 (Error): $1${NC}" >&2
}

# 顯示警告訊息
# Display warning message
warn_msg() {
    echo -e "${YELLOW}警告 (Warning): $1${NC}" >&2
}

# 顯示成功訊息
# Display success message
success_msg() {
    echo -e "${GREEN}$1${NC}"
}

# 編碼 v2 日誌欄位：路徑裡的 | 與換行都是合法字元，未轉義就會毀掉紀錄結構
# Encode a v2 log field: '|' and newlines are legal in a path and would
# otherwise break the delimiter and the one-record-per-line structure.
encode_log_field() {
    local value="$1"
    value="${value//\\/\\\\}"
    # 分隔符必須完全不出現在欄位裡：IFS 切割不認轉義，'\|' 一樣會被切開
    # The delimiter must not survive in the field at all: IFS splitting is not
    # escape-aware, so a '\|' would still be split.
    value="${value//|/\\p}"
    value="${value//$'\n'/\\n}"
    value="${value//$'\r'/\\r}"
    printf '%s' "$value"
}

# 解碼 v2 日誌欄位，結果寫入 LOG_FIELD_DECODED
# （不用命令替換回傳，否則結尾換行的檔名會被吃掉）
# Decode a v2 log field into LOG_FIELD_DECODED; a command substitution would
# strip a trailing newline that belongs to the filename.
decode_log_field() {
    local value="$1"
    # 沒有反斜線就沒有任何轉義序列，直接原樣回傳：還原時每筆掃過的紀錄都會呼叫
    # 這個函式，逐字元迴圈跑在正常路徑上會讓長日誌的掃描慢上數倍。
    # No backslash means no escape sequence, so the value is already decoded.
    # Restore calls this for every record it scans; running the per-character
    # loop on ordinary paths made scanning a long log several times slower.
    if [[ "$value" != *\\* ]]; then
        LOG_FIELD_DECODED="$value"
        return 0
    fi
    local out=""
    local index=0
    local length=${#value}
    local char
    while [ "$index" -lt "$length" ]; do
        char="${value:index:1}"
        if [ "$char" = '\' ] && [ $((index + 1)) -lt "$length" ]; then
            index=$((index + 1))
            case "${value:index:1}" in
                n) out+=$'\n' ;;
                r) out+=$'\r' ;;
                p) out+='|' ;;
                '\') out+='\' ;;
                *) out+="\\${value:index:1}" ;;
            esac
        else
            out+="$char"
        fi
        index=$((index + 1))
    done
    LOG_FIELD_DECODED="$out"
}

# 記錄刪除操作到日誌檔案
# Log deletion operation to log file
log_deletion() {
    local original_path="$1"
    local trash_path="$2"
    local file_hash="$3"
    local timestamp="$4"
    local file_type="$5"
    local log_file
    local log_dir
    log_file=$(get_deletion_log_file)
    log_dir="${log_file%/*}"

    # 確保狀態目錄存在，並限制新目錄的存取權限
    # Ensure the state directory exists with restrictive permissions
    if [ ! -d "$log_dir" ]; then
        if ! (umask 077; mkdir -p "$log_dir") 2>/dev/null; then
            warn_msg "無法建立日誌目錄: $log_dir"
            warn_msg "Failed to create log directory: $log_dir"
            return 1
        fi
    fi
    
    # 確保日誌檔案存在
    # Ensure log file exists
    if [ ! -f "$log_file" ]; then
        if ! (
            umask 077
            {
                echo "# Better-RM Deletion Log"
                echo "# 更好的 RM 刪除日誌"
                echo "# Format: TIMESTAMP | v2 | ORIGINAL_PATH | TRASH_PATH | HASH | FILE_TYPE"
                echo "# 格式：時間戳記 | v2 | 原始路徑 | 垃圾桶路徑 | 雜湊值 | 檔案類型"
                echo '# v2: path fields escape \\ (backslash) \p (pipe) \n (newline) \r (CR); records without the v2 marker use the legacy 5-field layout'
                echo '# v2：路徑欄位轉義 \\ 反斜線、\p 直線、\n 換行、\r 歸位；沒有 v2 標記的紀錄沿用舊版 5 欄格式'
                echo "# =============================================================================="
            } > "$log_file"
        ) 2>/dev/null; then
            # 日誌檔案創建失敗，顯示警告但不中斷操作
            # Log file creation failed, show warning but don't interrupt operation
            warn_msg "無法創建刪除日誌: $log_file"
            warn_msg "Failed to create deletion log: $log_file"
            return 1
        fi
    fi
    
    # 記錄刪除操作
    # Log the deletion operation
    if ! {
        printf '%s | v2 | %s | %s | %s | %s\n' \
            "$timestamp" "$(encode_log_field "$original_path")" \
            "$(encode_log_field "$trash_path")" "$file_hash" "$file_type" >> "$log_file"
    } 2>/dev/null; then
        # 記錄失敗，顯示警告但不中斷操作
        # Logging failed, show warning but don't interrupt operation
        warn_msg "無法寫入刪除日誌"
        warn_msg "Failed to write to deletion log"
        return 1
    fi
}

# 正規化路徑函式
# Normalize path function
normalize_path() {
    local path="$1"
    # 移除多餘的斜線
    # Remove multiple slashes
    path=$(echo "$path" | sed 's#/\+#/#g')
    
    # 處理 ./ 和 ../
    # Handle ./ and ../
    local IFS='/'
    local parts=()
    local part
    
    for part in $path; do
        if [ "$part" = ".." ]; then
            # 移除上一個元素（如果存在）
            if [ ${#parts[@]} -gt 0 ]; then
                unset 'parts[${#parts[@]}-1]'
                parts=("${parts[@]}")  # 重新索引陣列
            fi
        elif [ "$part" != "." ] && [ -n "$part" ]; then
            parts+=("$part")
        fi
    done
    
    # 重建路徑
    local normalized=""
    if [[ "$path" = /* ]]; then
        normalized="/"
    fi
    
    local first=1
    for part in "${parts[@]}"; do
        if [ $first -eq 1 ]; then
            normalized="${normalized}${part}"
            first=0
        else
            normalized="${normalized}/${part}"
        fi
    done
    
    # 如果結果為空且原始路徑以 / 開頭，返回 /
    if [ -z "$normalized" ] && [[ "$path" = /* ]]; then
        normalized="/"
    fi
    
    echo "$normalized"
}

# 檢查路徑是否為受保護的目錄
# Check if path is a protected directory
is_protected() {
    local path="$1"
    local real_path
    
    # 取得絕對路徑
    # Get absolute path
    # 引數自己就是一條符號連結時不解析：刪掉一條連結不會動到它指向的東西
    # （move_exact 用 -h／-T），拿 target 去比對保護清單是憑空造出來的誤判——
    # ~/applink -> /Applications 這種捷徑會整批變成刪不掉，-f 也蓋不過去。
    # 條件寫成 [ ! -L "$path" ] 而不是先剝掉結尾斜線：macOS 上 `link/` 指的是那個目錄
    # 而不是連結，實測 [ -L "link/" ] 與 [ -L "link/." ] 在 macOS 與 Linux 上都是 false
    # （結尾斜線依 POSIX 會強制解析最後一段），所以會穿過去的拼寫剛好留在解析這一側。
    # A symlink argument is not resolved: deleting a link cannot touch what it points
    # at (move_exact uses -h/-T), so comparing the target against the protected list
    # is a false positive by construction -- it made shortcuts such as
    # ~/applink -> /Applications undeletable, with -f unable to override.
    # The condition is [ ! -L "$path" ] rather than a trailing-slash strip: on macOS
    # `link/` denotes the directory, not the link, and [ -L "link/" ] and
    # [ -L "link/." ] are measured false on both macOS and Linux (a trailing slash
    # forces resolution of the final component), so every spelling that resolves
    # through the link stays on the resolving side.
    if [ ! -L "$path" ] && [ -e "$path" ]; then
        # 如果檔案存在，使用 readlink/realpath
        # 狀態非零就丟掉輸出：BSD 的 readlink -f 解析不完仍會把半途結果印出來
        # （實測斷連結印出 /Volumes/NotMounted12345 並 exit 1），採信那半截路徑等於
        # 拿一個沒人指名的目錄去比對保護清單。丟掉之後照舊往下走既有的 fallback。
        # Discard the output when the status is non-zero: BSD readlink -f still
        # prints the partial resolution when it cannot finish (measured: a dangling
        # link prints /Volumes/NotMounted12345 and exits 1). Trusting that half-path
        # compares a directory nobody named against the protected list. Discarding it
        # falls through to the existing fallbacks.
        real_path=$(readlink -f "$path" 2>/dev/null) || real_path=""
        if [ -z "$real_path" ]; then
            real_path=$(realpath "$path" 2>/dev/null)
        fi
        if [ -z "$real_path" ]; then
            # 兩者都失敗，手動解析
            if [[ "$path" = /* ]]; then
                real_path="$path"
            else
                real_path="$(pwd)/$path"
            fi
            real_path=$(normalize_path "$real_path")
        fi
    else
        # 連結本身，或根本不存在的路徑：一律用未解析的寫法解相對路徑
        # The link itself, or a path that does not exist: resolve the spelling as
        # given, without following anything
        if [[ "$path" = /* ]]; then
            real_path="$path"
        else
            real_path="$(pwd)/$path"
        fi
        real_path=$(normalize_path "$real_path")
    fi
    
    # 移除結尾的斜線以便比較
    # Remove trailing slash for comparison
    real_path="${real_path%/}"

    # 計算未解析符號連結的標準化絕對路徑，以支援如 macOS 的 /home, /etc, /var 等符號連結目錄的保護
    # Calculate normalized absolute path without symlink resolution to support directory symlinks like /home, /etc, /var on macOS
    local norm_path
    if [[ "$path" = /* ]]; then
        norm_path="$path"
    else
        norm_path="$(pwd)/$path"
    fi
    norm_path=$(normalize_path "$norm_path")
    norm_path="${norm_path%/}"
    
    # macOS firmlink：/System/Volumes/Data/X 與 /X 是同一個物件。實測 stat -f '%d:%i'，
    # /Users/sieg 與 /System/Volumes/Data/Users/sieg 同 device 同 inode，/Applications
    # 亦然。firmlink 不是 symlink，readlink -f 兩個方向都原樣送回，所以沒有任何正規化
    # 會讓兩種拼寫碰面——整個家目錄本來可以用 Data 卷宗的拼寫搬走。
    # 這裡用「把 Data 卷宗的前綴換掉」而不是比對 inode：inode 要求路徑存在，而還沒
    # 建立的家目錄同樣不能被穿過去；而且逐條 stat 整份清單會讓每一次刪除都變慢。
    # 前綴必須整段對齊（/System/Volumes/DataDrive 不算），對應之後照舊送進同一份
    # 逐條比對，所以只會多出拒絕、不會少掉任何一條既有的保護。
    # 侷限：這是拼寫層面的對應，不是身分證明——而這裡原本舉的例子方向剛好相反。
    # /System/Volumes/Data/usr 不是「不存在」：它是實際存在的目錄，裝著 /usr/local、
    # /usr/libexec/cups、/usr/share/snmp 這幾條 firmlink 在資料卷宗上的本體（見
    # /usr/share/firmlinks），而且與 /usr 的 inode 不同（同一個 stat -f '%d:%i' 實測）。
    # 它仍會被對應成 /usr 一併拒絕：擋下的是一個真實存在、卻不是 /usr 的目錄。方向是
    # 安全的那一邊，代價也小——真正與 /usr/local 同一顆 inode 的
    # /System/Volumes/Data/usr/local 對應成 /usr/local，照舊可刪。反過來，別種掛載方式
    # 造出的同一顆 inode 兩種拼寫（bind mount、hardlink 目錄）不在這條規則的涵蓋範圍內。
    # macOS firmlink: /System/Volumes/Data/X and /X are the same object. Measured with
    # stat -f '%d:%i', /Users/sieg and /System/Volumes/Data/Users/sieg share a device
    # and an inode, and so does /Applications. A firmlink is not a symlink and
    # readlink -f hands either spelling straight back, so no canonicalisation ever
    # brings the two together -- the whole home directory was removable under the
    # Data-volume spelling. The prefix is rewritten rather than compared by inode:
    # an inode needs the path to exist, and a home directory that has not been
    # created yet must not be walked through either, while stat-ing the whole list
    # on every deletion would slow down the common case. The prefix has to align on
    # a whole component (/System/Volumes/DataDrive is not a match) and the result
    # goes through the same exact-match comparisons as before, so this can only add
    # refusals, never remove one.
    # Limits: this is a spelling correspondence, not proof of identity -- and the
    # example that used to stand here had it backwards. /System/Volumes/Data/usr is
    # not absent: it is a real directory holding the data-volume side of the
    # /usr/local, /usr/libexec/cups and /usr/share/snmp firmlinks (see
    # /usr/share/firmlinks), and its inode differs from /usr's under the same
    # stat -f '%d:%i'. It is mapped onto /usr and refused with it all the same, so
    # what gets refused is an existing directory that is not /usr. That is the
    # fail-closed direction and it costs little: /System/Volumes/Data/usr/local,
    # which really is the same inode as /usr/local, maps to /usr/local and stays
    # removable. Conversely, two spellings of one inode produced by any other
    # mechanism (a bind mount, a hard-linked directory) are outside this rule.
    # 對應後的結果沿用上面「去掉結尾斜線」的表示法：根目錄在這個函式裡一路是空字串
    # （清單裡的 "/" 也被 ${protected%/} 削成空字串），所以 Data 卷宗根對應過去就是
    # 空字串，不能寫成 "/"，否則它反而比對不到 "/" 那一列。
    # The mapped result keeps the representation the trailing-slash strip above
    # established: the root directory is the empty string throughout this function
    # (the list's "/" is cut to the empty string by ${protected%/} as well), so the
    # Data volume root maps to the empty string. Writing "/" here would make it miss
    # the very row it has to match.
    local firmlink_prefix="/System/Volumes/Data"
    if [ "$real_path" = "$firmlink_prefix" ] || [[ "$real_path" = "$firmlink_prefix"/* ]]; then
        real_path="${real_path#"$firmlink_prefix"}"
    fi
    if [ "$norm_path" = "$firmlink_prefix" ] || [[ "$norm_path" = "$firmlink_prefix"/* ]]; then
        norm_path="${norm_path#"$firmlink_prefix"}"
    fi
    
    # 檢查是否與受保護目錄完全符合
    # Check if exactly matches protected directories
    for protected in "${PROTECTED_DIRS[@]}"; do
        protected="${protected%/}"
        if [ "$real_path" = "$protected" ] || [ "$norm_path" = "$protected" ]; then
            return 0  # 是受保護的目錄
        fi
    done

    # 使用者自行宣告的受保護目錄：BETTER_RM_PROTECTED_DIRS
    # 這是使用者唯一能自己加保護的介面。agent 路徑上的 hook 一直有讀它
    # （hooks/protect-important-paths.js 的 evaluate），而這裡一處都沒提到它——同一個
    # 變數在 agent 路徑上生效，在它本來要設定的 rm 替身上完全沒作用；使用者設了它、
    # 看見 agent 被擋，就會以為兩邊都受保護了。
    # 解析與 hook 逐項對齊：以 ':' 分隔（Node 的 path.delimiter 在這兩個平台就是它）、
    # 空項略過、相對項以工作目錄為基準解析，然後照 PROTECTED_DIRS 那一份做完全比對，
    # 所以保護的是宣告的那個目錄本身而非其內容。
    # 空項不是小事：""會解析成當前目錄，一個結尾冒號就讓使用者的工作目錄變成刪不掉的。
    # 用 read -ra 而不是讓變數自己斷詞：後者會對含有萬用字元的項目做路徑展開，而 hook
    # 那邊只是 split，不展開。
    # BETTER_RM_PROTECTED_DIRS: the only interface a user has for adding protection of
    # their own. The agent-path hook has always read it (evaluate() in
    # hooks/protect-important-paths.js) while this file never mentioned it, so the
    # same variable hardened the agent path and did nothing for the rm replacement it
    # exists to configure -- a user who sets it and watches the agent get refused
    # believes both paths are covered.
    # The parsing matches the hook's entry for entry: ':' separated (Node's
    # path.delimiter on both platforms), empty entries skipped, relative entries
    # resolved against the working directory, then compared exactly like the list
    # above, so what is protected is the declared directory and not its contents.
    # The empty entry is not a detail: "" resolves to the current directory, so a
    # single trailing colon would make the user's own working directory undeletable.
    # read -ra rather than letting the variable word-split: the latter would also
    # glob an entry containing a wildcard, while the hook only splits.
    local -a declared_extras=()
    if [ -n "${BETTER_RM_PROTECTED_DIRS:-}" ]; then
        local extra_entry
        local -a extra_entries=()
        IFS=: read -ra extra_entries <<< "$BETTER_RM_PROTECTED_DIRS"
        for extra_entry in "${extra_entries[@]}"; do
            [ -n "$extra_entry" ] || continue
            if [[ "$extra_entry" != /* ]]; then
                extra_entry="$(pwd)/$extra_entry"
            fi
            extra_entry=$(normalize_path "$extra_entry")
            extra_entry="${extra_entry%/}"
            # 收下正規化後的拼寫，讓底下的身分比對能問同一批項目，而不是把這段解析
            # 再抄一次。
            # Keep the normalised spelling so the identity comparison below asks about
            # the same entries instead of carrying a second copy of this parse.
            declared_extras[${#declared_extras[@]}]="$extra_entry"
            if [ "$real_path" = "$extra_entry" ] || [ "$norm_path" = "$extra_entry" ]; then
                return 0  # 使用者宣告的受保護目錄
            fi
        done
    fi

    # 保護掛載根本身及其第一層掛載根（例如 WSL 的 /mnt/c、macOS 的 /Volumes/Backup），但允許操作掛載點內的項目
    # /System/Volumes 是現代 Mac 掛載自己那幾顆 APFS 卷宗（Data、Preboot、VM、Update…）的地方
    # Protect the mount parents and their immediate mount roots (for example /mnt/c on WSL, /Volumes/Backup on macOS), while allowing items inside them
    # /System/Volumes is where a modern Mac mounts its own APFS volumes (Data, Preboot, VM, Update, ...)
    local mount_parent candidate remainder
    for mount_parent in /mnt /Volumes /System/Volumes; do
        for candidate in "$real_path" "$norm_path"; do
            if [[ "$candidate" = "$mount_parent"/* ]]; then
                remainder="${candidate#"$mount_parent"/}"
                if [ -n "$remainder" ] && [[ "$remainder" != */* ]]; then
                    return 0
                fi
            fi
        done
    done

    # 檢查是否符合受保護的模式
    # Check if matches protected patterns
    local basename_path=$(basename "$real_path")
    local basename_norm=$(basename "$norm_path")
    for pattern in "${PROTECTED_PATTERNS[@]}"; do
        pattern="${pattern%/}"
        if [[ "$basename_path" = ${pattern} ]] || [[ "$real_path" = */${pattern} ]] || [[ "$real_path" = ${pattern} ]] || \
           [[ "$basename_norm" = ${pattern} ]] || [[ "$norm_path" = */${pattern} ]] || [[ "$norm_path" = ${pattern} ]]; then
            return 0  # 符合受保護模式
        fi
    done
    
    # 引數自己就是一條連結時，上面每一輪比的都是「拼寫」——而拼寫是字串，清單上的項目
    # 卻是一個物件。這台 Mac 上 /etc、/var、/home 都是連結：/ETC 與 /etc 是同一條連結
    # （實測 stat 同 dev:ino），卻只有小寫那種寫法被擋下來；是真目錄的項目則在
    # readlink -f 之後全都折對了，因為那一段有問過檔案系統。所以這裡也去問檔案系統
    # 「這個引數是不是清單上那一項」，而不是把字串折成小寫——後者是在猜這顆卷宗分不分
    # 大小寫，猜錯的那一邊會誤擋。
    # 兩邊都用 stat 的預設語意（不加 -L，BSD 與 GNU 皆為 lstat）：問的是「引數是不是那
    # 一項」，不是「兩者指到同一處」；跟著解析下去會讓 ~/applink -> /Applications 這種
    # 捷徑變成刪不掉的，而那正是 2c34f8d 立下不解析規則的理由。
    # 成本：只有「引數本身是連結」才會走到（其餘情形上面的 readlink -f 已經答過），而且
    # 只對清單裡本身也是連結的項目 stat（[ -L ] 是內建測試，不 fork）。
    # A symlink argument is judged by its SPELLING once every rule above has missed,
    # and a spelling is a string while a list entry is an object. On this Mac /etc,
    # /var and /home are symlinks: /ETC names the same link as /etc (measured with
    # stat: one dev:ino) and only the lower-case spelling was refused, while every
    # entry that is a real directory folded correctly because readlink -f had asked
    # the filesystem. So ask the filesystem here too -- is this argument that entry?
    # -- rather than folding the string, which guesses at whether the volume is
    # case-insensitive and refuses ordinary paths where the guess is wrong.
    # stat's default semantics on BOTH sides (no -L; lstat on BSD and GNU alike):
    # the question is whether the argument IS that entry, never whether the two
    # point at the same place. Following either side would make ~/applink ->
    # /Applications undeletable, which is the false positive 2c34f8d exists to
    # prevent.
    if [ -L "$path" ]; then
        local link_identity declared_identity declared_entry
        link_identity=$(stat -c '%d:%i' "$path" 2>/dev/null ||
            stat -f '%d:%i' "$path" 2>/dev/null || true)
        if [ -n "$link_identity" ]; then
            for declared_entry in "${PROTECTED_DIRS[@]}" \
                                  ${declared_extras[@]+"${declared_extras[@]}"}; do
                declared_entry="${declared_entry%/}"
                [ -n "$declared_entry" ] || continue
                # 成本短路，不是規則：拿掉它判定不會變，套件也不會紅（實測）。inode 在
                # 同一個 device 內唯一，不是連結的項目不可能與這個引數同 dev:ino。它省下
                # 的是 stat：這個測試是內建的（不 fork），一次擋掉二十幾次 stat 呼叫。
                # A COST short-circuit, not a rule: removing it cannot change a verdict
                # and no test goes red for it (measured). An inode is unique within its
                # device, so an entry that is not a link can never carry this
                # argument's dev:ino. What it saves is the stat -- the test itself is a
                # builtin, and it removes twenty-odd forks per symlink argument.
                [ -L "$declared_entry" ] || continue
                declared_identity=$(stat -c '%d:%i' "$declared_entry" 2>/dev/null ||
                    stat -f '%d:%i' "$declared_entry" 2>/dev/null || true)
                if [ -n "$declared_identity" ] && [ "$link_identity" = "$declared_identity" ]; then
                    return 0  # 引數就是清單上那一條連結，只是換了一種拼寫
                fi
            done
        fi
    fi

    return 1  # 不是受保護的目錄
}

